generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                       String               @id @default(uuid())
  email                    String               @unique
  password                 String
  firstName                String
  lastName                 String
  phone                    String?
  address                  String?
  city                     String?
  avatar                   String?
  isActive                 Boolean              @default(true)
  permissions              Json?
  notificationPrefs        Json?
  createdAt                DateTime             @default(now())
  updatedAt                DateTime             @updatedAt
  isVerified               Boolean              @default(false)
  verificationToken        String?
  verificationTokenExpires DateTime?
  ingenioAccess            Boolean              @default(false)
  initialInterface         String               @default("OSCORP")
  roles                    UserRole[]           @default([client])
  resetToken               String?
  resetTokenExpires        DateTime?
  bankData                 BankData?
  budgetItems              BudgetItem[]
  budgets                  Budget[]
  cartItems                CartItem[]
  credits                  Credit[]
  financialCategories      FinancialCategory[]
  financialRecords         FinancialRecord[]
  ingenioReferredBy        IngenioStudent[]     @relation("StudentReferredBy")
  ingenioStudent           IngenioStudent?
  ingenioSubscription      IngenioSubscription?
  notifications            Notification[]
  ordersAsBuyer            Order[]              @relation("BuyerOrders")
  ordersAsSeller           Order[]              @relation("SellerOrders")
  pushSubscriptions        PushSubscription[]
  reviews                  Review[]
  sellerProfile            SellerProfile?
  sellerSubscription       SellerSubscription?
  transactions             Transaction[]
  userCourses              UserCourse[]
  virtualCard              VirtualCard?
  wallet                   Wallet?
  ingenioReferrals         IngenioStudent[]     @relation("StudentReferrals")

  @@map("users")
}

model BankData {
  id            String @id @default(uuid())
  userId        String @unique
  bankName      String
  accountNumber String
  accountType   String
  holderName    String
  documentId    String
  user          User   @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("bank_data")
}

model SellerProfile {
  id               String            @id @default(uuid())
  userId           String            @unique
  storeName        String
  storeSlug        String            @unique
  description      String
  logo             String?
  banner           String?
  address          String
  phone            String
  email            String
  whatsappNumber   String
  isVerified       Boolean           @default(false)
  planActive       Boolean           @default(false)
  planExpiryDate   DateTime?
  commissionRate   Float             @default(5.0)
  totalSales       Int               @default(0)
  totalRevenue     Float             @default(0)
  rating           Float             @default(0)
  reviewCount      Int               @default(0)
  businessHours    Json?
  socialLinks      Json?
  category         String            @default("General")
  planId           String?
  createdAt        DateTime          @default(now())
  updatedAt        DateTime          @updatedAt
  ruc              String?
  customers        Customer[]
  products         Product[]
  purchases        Purchase[]
  sellerCategories SellerCategory[]
  sellerMovements  SellerMovement[]
  plan             SubscriptionPlan? @relation(fields: [planId], references: [id])
  user             User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  store            Store?
  suppliers        Supplier[]

  @@map("seller_profiles")
}

model Store {
  id             String        @id @default(uuid())
  sellerId       String        @unique
  name           String
  slug           String        @unique
  description    String
  logo           String?
  banner         String?
  address        String
  phone          String
  email          String
  whatsappNumber String
  isActive       Boolean       @default(true)
  isOnline       Boolean       @default(true)
  businessHours  Json?
  socialLinks    Json?
  category       String        @default("General")
  reviews        Review[]
  sellerProfile  SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("stores")
}

model Supplier {
  id             String          @id @default(uuid())
  sellerId       String
  name           String
  contactName    String?
  email          String?
  phone          String?
  address        String?
  taxId          String?
  paymentTerms   String?
  notes          String?
  isActive       Boolean         @default(true)
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  products       Product[]
  purchases      Purchase[]
  stockMovements StockMovement[]
  seller         SellerProfile   @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("suppliers")
}

model Customer {
  id        String        @id @default(uuid())
  sellerId  String
  fullName  String
  address   String?
  phone     String?
  ruc       String?
  city      String?
  notes     String?
  isActive  Boolean       @default(true)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt
  seller    SellerProfile @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("customers")
}

model SellerCategory {
  id        String           @id @default(uuid())
  sellerId  String
  name      String
  type      String
  color     String           @default("#3B82F6")
  icon      String           @default("wallet")
  isSystem  Boolean          @default(false)
  createdAt DateTime         @default(now())
  seller    SellerProfile    @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  movements SellerMovement[]

  @@map("seller_categories")
}

model SellerMovement {
  id            String         @id @default(uuid())
  sellerId      String
  categoryId    String
  type          String
  amount        Float
  description   String
  voucherNumber String?
  date          DateTime       @default(now())
  reference     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  category      SellerCategory @relation(fields: [categoryId], references: [id])
  seller        SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)

  @@map("seller_movements")
}

model Purchase {
  id            String         @id @default(uuid())
  sellerId      String
  supplierId    String
  invoiceName   String?
  invoiceNumber String
  purchaseDate  DateTime       @default(now())
  totalAmount   Float          @default(0)
  status        String         @default("completed")
  notes         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  items         PurchaseItem[]
  seller        SellerProfile  @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  supplier      Supplier       @relation(fields: [supplierId], references: [id])

  @@map("purchases")
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Int
  unitCost   Float
  totalCost  Float
  product    Product  @relation(fields: [productId], references: [id])
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)

  @@map("purchase_items")
}

model StockMovement {
  id         String    @id @default(uuid())
  productId  String
  type       String
  quantity   Int
  reason     String?
  reference  String?
  supplierId String?
  cost       Float?
  createdAt  DateTime  @default(now())
  product    Product   @relation(fields: [productId], references: [id], onDelete: Cascade)
  supplier   Supplier? @relation(fields: [supplierId], references: [id])

  @@map("stock_movements")
}

model Product {
  id               String             @id @default(uuid())
  sellerId         String
  name             String
  description      String
  price            Float
  cost             Float?             @default(0)
  profitPercentage Float?             @default(0)
  comparePrice     Float?
  stock            Int                @default(0)
  sku              String             @unique
  images           String[]
  category         String
  subcategory      String?
  type             ProductType        @default(physical)
  visibility       ProductVisibility  @default(both)
  status           String             @default("active")
  weight           Float?
  dimensions       Json?
  tags             String[]
  isFeatured       Boolean            @default(false)
  createdAt        DateTime           @default(now())
  updatedAt        DateTime           @updatedAt
  supplierId       String?
  cartItems        CartItem[]
  orderItems       OrderItem[]
  attributes       ProductAttribute[]
  variants         ProductVariant[]
  seller           SellerProfile      @relation(fields: [sellerId], references: [id], onDelete: Cascade)
  supplier         Supplier?          @relation(fields: [supplierId], references: [id])
  purchaseItems    PurchaseItem[]
  reviews          Review[]
  stockMovements   StockMovement[]

  @@map("products")
}

model ProductVariant {
  id        String  @id @default(uuid())
  productId String
  name      String
  price     Float
  stock     Int     @default(0)
  sku       String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_variants")
}

model ProductAttribute {
  id        String  @id @default(uuid())
  productId String
  name      String
  value     String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@map("product_attributes")
}

model Wallet {
  id             String        @id @default(uuid())
  userId         String        @unique
  balance        Float         @default(0)
  currency       String        @default("USD")
  status         String        @default("active")
  dailyLimit     Float         @default(1000)
  monthlyLimit   Float         @default(10000)
  totalIn        Float         @default(0)
  totalOut       Float         @default(0)
  transactionPin String?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  rewardPoints   Int           @default(0)
  transactions   Transaction[]
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("wallets")
}

model VirtualCard {
  id         String     @id @default(uuid())
  userId     String     @unique
  walletId   String     @unique
  cardNumber String     @unique
  qrCode     String?
  qrData     String?
  design     CardDesign @default(gradient_blue)
  isActive   Boolean    @default(true)
  createdAt  DateTime   @default(now())
  user       User       @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("virtual_cards")
}

model Transaction {
  id              String          @id @default(uuid())
  walletId        String
  userId          String
  type            TransactionType
  amount          Float
  currency        String          @default("USD")
  description     String
  category        String?
  status          String          @default("completed")
  relatedUserId   String?
  relatedOrderId  String?
  relatedCreditId String?
  metadata        Json?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  user            User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  wallet          Wallet          @relation(fields: [walletId], references: [id], onDelete: Cascade)

  @@map("transactions")
}

model Order {
  id                String          @id @default(uuid())
  orderNumber       String          @unique
  buyerId           String
  sellerId          String
  subtotal          Float
  tax               Float           @default(0)
  shippingCost      Float           @default(0)
  discount          Float           @default(0)
  total             Float
  status            OrderStatus     @default(pending)
  paymentStatus     PaymentStatus   @default(pending)
  paymentMethod     PaymentMethod   @default(wallet)
  deliveryType      String
  deliveryAddress   Json?
  deliveryNotes     String?
  estimatedDelivery DateTime?
  actualDelivery    DateTime?
  commissionAmount  Float           @default(0)
  sellerEarnings    Float           @default(0)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt
  isPosSale         Boolean         @default(false)
  items             OrderItem[]
  buyer             User            @relation("BuyerOrders", fields: [buyerId], references: [id])
  seller            User            @relation("SellerOrders", fields: [sellerId], references: [id])
  trackingHistory   TrackingEvent[]

  @@map("orders")
}

model OrderItem {
  id           String  @id @default(uuid())
  orderId      String
  productId    String
  productName  String
  productImage String?
  quantity     Int
  unitPrice    Float
  total        Float
  variant      String?
  order        Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product      Product @relation(fields: [productId], references: [id])

  @@map("order_items")
}

model TrackingEvent {
  id          String      @id @default(uuid())
  orderId     String
  status      OrderStatus
  description String
  timestamp   DateTime    @default(now())
  location    String?
  order       Order       @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@map("tracking_events")
}

model Course {
  id               String       @id @default(uuid())
  title            String
  slug             String       @unique
  description      String
  shortDescription String
  coverImage       String?
  previewVideo     String?
  instructorId     String
  instructorName   String
  category         String
  level            CourseLevel  @default(beginner)
  price            Float        @default(0)
  comparePrice     Float?
  duration         Int          @default(0)
  isPublished      Boolean      @default(false)
  isFeatured       Boolean      @default(false)
  enrolledCount    Int          @default(0)
  rating           Float        @default(0)
  reviewCount      Int          @default(0)
  createdAt        DateTime     @default(now())
  updatedAt        DateTime     @updatedAt
  updateYear       String?
  modules          Module[]
  resources        Resource[]
  userCourses      UserCourse[]

  @@map("courses")
}

model Module {
  id          String   @id @default(uuid())
  courseId    String
  title       String
  description String
  order       Int
  lessons     Lesson[]
  course      Course   @relation(fields: [courseId], references: [id], onDelete: Cascade)

  @@map("modules")
}

model Lesson {
  id          String     @id @default(uuid())
  moduleId    String
  title       String
  description String
  videoUrl    String?
  duration    Int        @default(0)
  order       Int
  isPreview   Boolean    @default(false)
  module      Module     @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  resources   Resource[]

  @@map("lessons")
}

model Resource {
  id       String  @id @default(uuid())
  courseId String?
  lessonId String?
  title    String
  type     String
  url      String
  course   Course? @relation(fields: [courseId], references: [id], onDelete: Cascade)
  lesson   Lesson? @relation(fields: [lessonId], references: [id], onDelete: Cascade)

  @@map("resources")
}

model UserCourse {
  id                String    @id @default(uuid())
  userId            String
  courseId          String
  status            String    @default("active")
  progress          Float     @default(0)
  completedModules  String[]
  completedLessons  String[]
  totalTimeSpent    Int       @default(0)
  lastAccessedAt    DateTime  @default(now())
  completedAt       DateTime?
  certificateIssued Boolean   @default(false)
  createdAt         DateTime  @default(now())
  course            Course    @relation(fields: [courseId], references: [id], onDelete: Cascade)
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, courseId])
  @@map("user_courses")
}

model Credit {
  id                String                @id @default(uuid())
  userId            String
  amount            Float
  concept           String
  installments      Int
  installmentAmount Float
  totalToPay        Float
  interestRate      Float                 @default(0)
  status            CreditStatus          @default(pending)
  approvedBy        String?
  approvedAt        DateTime?
  createdAt         DateTime              @default(now())
  updatedAt         DateTime              @updatedAt
  documents         CreditDocument[]
  payments          CreditPayment[]
  user              User                  @relation(fields: [userId], references: [id], onDelete: Cascade)
  paymentSchedule   PaymentScheduleItem[]

  @@map("credits")
}

model CreditDocument {
  id         String   @id @default(uuid())
  creditId   String
  type       String
  url        String
  uploadedAt DateTime @default(now())
  credit     Credit   @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@map("credit_documents")
}

model PaymentScheduleItem {
  id                String          @id @default(uuid())
  creditId          String
  installmentNumber Int
  dueDate           DateTime
  amount            Float
  principal         Float
  interest          Float
  status            String          @default("pending")
  paidAt            DateTime?
  payments          CreditPayment[]
  credit            Credit          @relation(fields: [creditId], references: [id], onDelete: Cascade)

  @@map("payment_schedule_items")
}

model CreditPayment {
  id            String              @id @default(uuid())
  creditId      String
  installmentId String
  amount        Float
  paidAt        DateTime            @default(now())
  paymentMethod String
  credit        Credit              @relation(fields: [creditId], references: [id], onDelete: Cascade)
  installment   PaymentScheduleItem @relation(fields: [installmentId], references: [id], onDelete: Cascade)

  @@map("credit_payments")
}

model FinancialCategory {
  id        String            @id @default(uuid())
  userId    String
  name      String
  type      FinancialType
  color     String            @default("#3B82F6")
  icon      String            @default("wallet")
  isDefault Boolean           @default(false)
  createdAt DateTime          @default(now())
  user      User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  records   FinancialRecord[]

  @@map("financial_categories")
}

model FinancialRecord {
  id                String            @id @default(uuid())
  userId            String
  categoryId        String
  type              FinancialType
  amount            Float
  description       String
  date              DateTime          @default(now())
  isRecurring       Boolean           @default(false)
  recurrencePattern String?
  attachments       String[]
  createdAt         DateTime          @default(now())
  notes             String?
  category          FinancialCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  user              User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("financial_records")
}

model BudgetItem {
  id             String        @id @default(uuid())
  userId         String
  month          Int
  year           Int
  type           FinancialType
  name           String
  description    String?
  amount         Float
  createdAt      DateTime      @default(now())
  durationMonths Int           @default(1)
  startDate      DateTime      @default(now())
  actualAmount   Float         @default(0)
  savedAmount    Float         @default(0)
  status         String        @default("ACTIVE")
  user           User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("budget_items")
}

model Budget {
  id             String   @id @default(uuid())
  userId         String
  month          Int
  year           Int
  incomeGoal     Float    @default(0)
  expenseLimit   Float    @default(0)
  categoryLimits Json?
  createdAt      DateTime @default(now())
  durationMonths Int      @default(1)
  startDate      DateTime @default(now())
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, month, year])
  @@map("budgets")
}

model Notification {
  id         String    @id @default(uuid())
  campaignId String?
  userId     String
  title      String
  message    String
  type       String    @default("info")
  isRead     Boolean   @default(false)
  imageUrl   String?
  actionUrl  String?
  clickedAt  DateTime?
  createdAt  DateTime  @default(now())
  campaign   Campaign? @relation(fields: [campaignId], references: [id])
  user       User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("notifications")
}

model Campaign {
  id            String         @id @default(uuid())
  title         String
  message       String
  imageUrl      String?
  actionUrl     String?
  targetRole    String         @default("all")
  status        String         @default("draft")
  sentAt        DateTime?
  createdBy     String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  notifications Notification[]

  @@map("campaigns")
}

model PushSubscription {
  id        String   @id @default(uuid())
  userId    String
  endpoint  String   @unique
  p256dh    String
  auth      String
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("push_subscriptions")
}

model CartItem {
  id        String  @id @default(uuid())
  userId    String
  productId String
  quantity  Int     @default(1)
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@map("cart_items")
}

model Review {
  id        String   @id @default(uuid())
  userId    String
  productId String?
  storeId   String?
  rating    Int
  comment   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  product   Product? @relation(fields: [productId], references: [id], onDelete: Cascade)
  store     Store?   @relation(fields: [storeId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("reviews")
}

model IngenioSubscription {
  id            String                    @id @default(uuid())
  userId        String                    @unique
  status        IngenioSubscriptionStatus @default(PENDING_PAYMENT)
  totalAmount   Float                     @default(0)
  installments  Int                       @default(1)
  paidAmount    Float                     @default(0)
  paymentMethod String?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  approvedAt    DateTime?
  receiptUrl    String?
  receipts      Json?                     @default("[]")
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("ingenio_subscriptions")
}

model SellerSubscription {
  id            String                    @id @default(uuid())
  userId        String                    @unique
  planId        String
  status        IngenioSubscriptionStatus @default(PENDING_PAYMENT)
  billingCycle  String                    @default("monthly")
  totalAmount   Float                     @default(0)
  paidAmount    Float                     @default(0)
  paymentMethod String?
  receiptUrl    String?
  receipts      Json?                     @default("[]")
  approvedAt    DateTime?
  expiresAt     DateTime?
  createdAt     DateTime                  @default(now())
  updatedAt     DateTime                  @updatedAt
  
  user          User                      @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan          SubscriptionPlan          @relation(fields: [planId], references: [id])

  @@map("seller_subscriptions")
}

model SystemSetting {
  id          String   @id @default(uuid())
  key         String   @unique
  value       String
  description String?
  group       String   @default("general")
  isPublic    Boolean  @default(false)
  updatedAt   DateTime @updatedAt

  @@map("system_settings")
}

model IngenioStage {
  id            String                @id @default(uuid())
  name          String
  title         String
  description   String?
  color         String                @default("#8b5cf6")
  order         Int                   @default(0)
  isActive      Boolean               @default(true)
  createdAt     DateTime              @default(now())
  updatedAt     DateTime              @updatedAt
  contents      IngenioContent[]
  wheelSegments IngenioWheelSegment[]

  @@map("ingenio_stages")
}

model IngenioWheelSegment {
  id          String       @id @default(uuid())
  stageId     String
  number      Int
  title       String
  description String
  color       String
  icon        String?
  order       Int          @default(0)
  isActive    Boolean      @default(true)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  stage       IngenioStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@unique([stageId, number])
  @@map("ingenio_wheel_segments")
}

model IngenioContent {
  id        String       @id @default(uuid())
  stageId   String
  segmentId String?
  type      String
  title     String
  content   String?
  url       String?
  fileUrl   String?
  order     Int          @default(0)
  isActive  Boolean      @default(true)
  createdAt DateTime     @default(now())
  updatedAt DateTime     @updatedAt
  stage     IngenioStage @relation(fields: [stageId], references: [id], onDelete: Cascade)

  @@map("ingenio_contents")
}

model IngenioStudent {
  id                          String                        @id @default(uuid())
  userId                      String                        @unique
  phone                       String?
  city                        String?
  country                     String                        @default("Paraguay")
  occupation                  String?
  experience                  String?
  goals                       String?
  referralCode                String?                       @unique
  referredById                String?
  isActive                    Boolean                       @default(true)
  joinedAt                    DateTime                      @default(now())
  updatedAt                   DateTime                      @updatedAt
  assignments                 IngenioStudentAssignment[]
  referredBy                  User?                         @relation("StudentReferredBy", fields: [referredById], references: [id])
  user                        User                          @relation(fields: [userId], references: [id], onDelete: Cascade)
  referrals                   User[]                        @relation("StudentReferrals")

  @@map("ingenio_students")
}

model SubscriptionPlan {
  id                String          @id @default(uuid())
  name              String
  tier              String          @default("basic")
  description       String
  price             Float           @default(0)
  prices            Json?
  features          String[]
  maxProducts       Int             @default(30)
  hasReports        Boolean         @default(false)
  commissionRate    Float           @default(0)
  isCommissionBased Boolean         @default(false)
  isActive          Boolean         @default(true)
  createdAt         DateTime        @default(now())
  updatedAt         DateTime
  sellerProfiles    SellerProfile[]
  sellerSubscriptions SellerSubscription[]

  @@map("subscription_plans")
}

model IngenioMaterial {
  id            String   @id @default(uuid())
  stage         String
  title         String
  description   String?
  fileUrl       String
  fileType      String
  fileSize      Int?
  isPublic      Boolean  @default(false)
  order         Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  segmentNumber Int      @default(1)

  @@map("ingenio_materials")
}

model IngenioStudentAssignment {
  id               String         @id @default(uuid())
  studentId        String
  stage            String
  status           String         @default("pending")
  progress         Int            @default(0)
  assignedAt       DateTime       @default(now())
  startedAt        DateTime?
  completedAt      DateTime?
  notes            String?
  student          IngenioStudent @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([studentId, stage])
  @@map("ingenio_student_assignments")
}

